#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
jar="$script_dir/../target/skill-scan-0.1.0.jar"

if [ ! -f "$jar" ]; then
    printf '%s\n' "skill-atlas: build the CLI first with 'mvn package'" >&2
    exit 1
fi

exec java --enable-native-access=ALL-UNNAMED -jar "$jar" "$@"
